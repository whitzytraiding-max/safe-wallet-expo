{
  "expo": {
    "name": "Safe Wallet",
    "slug": "safe-wallet-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safewallet",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.whitzy.safewallet",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Used to secure your Safe Wallet with Face ID"
      },
      "associatedDomains": ["webcredentials:awakensystem.app"],
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.whitzy.safewallet",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0E14"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E14"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E14",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
